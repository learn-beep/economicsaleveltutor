---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { allPapers, byId, topicByslug, PEARSON_MATERIALS } from '../../lib/data';
export function getStaticPaths() {
  return allPapers.map((p) => ({ params: { slug: p.slug }, props: { paper: p } }));
}
const { paper } = Astro.props;
const qs = paper.questions.map((id) => byId.get(id)).filter(Boolean);
const old = qs.filter((q) => q.notCurrentSpec).length;
const title = `${paper.series} ${paper.qual === 'AS' ? 'AS ' : ''}${paper.paper} (${paper.spec}/${paper.paperNo})`;
---
<Base title={`Edexcel Economics ${title}: questions, mark scheme and examiner's report by question`} description={`Every question in Edexcel Economics ${title} with its topic, marks and AO split, the mark scheme and the examiner's comments.`} context={`paper:${paper.slug}`} leadLine="Want a paper marked and gone through with you? Message us.">
  <h1>{paper.series}: {paper.qual === 'AS' ? 'AS ' : ''}{paper.paper}</h1>
  <p class="muted">{paper.total} marks · {qs.length} question parts · <a href={PEARSON_MATERIALS} rel="noopener">Paper, mark scheme and report on Pearson's site</a>{paper.series.startsWith('October 2020') ? ' · The October 2020 papers are the papers printed for the cancelled summer 2020 exams' : ''}</p>
  <h2>Question by question</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Q</th><th>Topic</th><th>Marks</th><th>AO</th><th>Type</th></tr></thead>
    <tbody>{qs.map((q) => <tr>
      <td><a href={`#${q.id}`}>{q.question}</a></td>
      <td>{q.topics.map((t, i) => <>{i ? ', ' : ''}<a href={`/questions/${t}/`}>{topicByslug.get(t)?.name ?? t}</a></>)}{q.notCurrentSpec && <span class="pill pill-hard" style="margin-left:.4rem">Old spec</span>}</td>
      <td>{q.marks}</td><td>{q.aoText}</td><td>{q.format}</td>
    </tr>)}</tbody>
  </table></div>
  <h2>The questions</h2>
  <div class="jump">{qs.map((q) => <a href={`#${q.id}`}>{q.question}</a>)}</div>
  {qs.map((q) => <QuestionCard q={q} showTopics={true} />)}
</Base>
