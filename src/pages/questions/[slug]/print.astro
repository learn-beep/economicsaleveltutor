---
import { allTopics, questionsForTopic } from '../../../lib/data';
import { cropsOn } from '../../../lib/site';
import '../../../styles/global.css';
export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = questionsForTopic(topic.slug).filter((q) => !q.notCurrentSpec);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
  <title>{topic.name}: Pearson Edexcel past-paper questions pack</title>
  <style>
    .cover { break-after: page; } .coversheet { width: 100%; border-collapse: collapse; margin: 1rem 0; } .coversheet td { border-bottom: 1px solid #999; padding: .6rem .4rem; } .coversheet td:first-child { width: 8rem; color: #444; }
    body { background: #fff; color: #000; padding: 0; margin: 1rem; font-family: var(--font); }
    .pack h1 { font-size: 1.4rem; margin: 0 0 .25rem; } .pack .muted { font-size: .9rem; }
    .pack .q { break-inside: avoid; margin: 0 0 1rem; border-top: 1px solid #ccc; padding-top: .5rem; }
    .pack .q .meta { font-size: .9rem; color: #444; margin-bottom: .25rem; } .pack img { width: 100%; height: auto; display: block; }
    .pack h2 { break-before: page; font-size: 1.2rem; } .toolbar { margin: 0 0 1rem; }
    @media print { .toolbar { display: none; } body { margin: 0; } }
  </style>
</head>
<body class="pack">
  <div class="toolbar"><button class="btn btn-accent" type="button" onclick="window.print()">Print or save as PDF</button> <a class="btn" href={`/questions/${topic.slug}/`}>Back to the topic page</a></div>
  <div class="cover"><h1>{topic.name}</h1><p class="muted">Past-paper questions pack</p><table class="coversheet"><tr><td>Name</td><td></td></tr><tr><td>Class</td><td></td></tr><tr><td>Date set</td><td></td></tr><tr><td>Date due</td><td></td></tr><tr><td>Score</td><td>/ {qs.reduce((n, q) => n + q.marks, 0)}</td></tr></table><p class="muted">Questions are numbered; the mark schemes (the answer key) follow on separate pages so the question pages can be handed out alone. www.economicsaleveltutor.com</p></div>
  <p class="muted">Pearson Edexcel AS and A-level Economics past-paper questions since 2016 · {qs.length} parts · mark schemes follow the questions · www.economicsaleveltutor.com · Questions and mark schemes © Pearson Edexcel</p>
  {cropsOn ? qs.map((q, i) => <div class="q"><div class="meta">{i + 1}. {q.series} · {q.level === 'AS' ? 'AS ' : ''}{q.paper} · Q{q.question} · {q.marks} marks · {q.aoText}</div><img src={q.crop} alt={q.text} /></div>) : <p>Crops are not available in this build.</p>}
  <h2>Mark schemes</h2>
  {cropsOn && qs.filter((q) => q.msCrop).map((q, i) => <div class="q"><div class="meta">{i + 1}. {q.series} · {q.level === 'AS' ? 'AS ' : ''}{q.paper} · Q{q.question}</div><img src={q.msCrop} alt={`Mark scheme ${q.series} ${q.paper} Q${q.question}`} /></div>)}
</body>
</html>
